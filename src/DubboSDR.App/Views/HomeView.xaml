<UserControl x:Class="DubboSDR.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="DubboSDR" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,40,0,20"/>
        
        <UniformGrid Grid.Row="1" Columns="1" Rows="2" Margin="40">
            <!-- Kids Radio Button -->
            <Button x:Name="BtnKidsRadio" Margin="0,0,0,20" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="BtnKidsRadio_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🎵" FontSize="72" HorizontalAlignment="Center"/>
                                <TextBlock Text="KIDS RADIO" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="Big touch mode" FontSize="18" HorizontalAlignment="Center" Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <!-- Explorer Button -->
            <Button x:Name="BtnExplorer" Margin="0,20,0,0" Background="#2196F3" Foreground="White" BorderThickness="0" Click="BtnExplorer_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📡" FontSize="72" HorizontalAlignment="Center"/>
                                <TextBlock Text="EXPLORE" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="Radio &amp; signals" FontSize="18" HorizontalAlignment="Center" Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
