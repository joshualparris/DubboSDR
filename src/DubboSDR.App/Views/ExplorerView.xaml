<UserControl x:Class="DubboSDR.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="White">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBack" Grid.Column="0" Content="← Home" Click="BtnBack_Click" Background="#444" Margin="0,0,15,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="DubboSDR Explorer" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="TxtStatus" Text="● Connected" Foreground="LightGreen" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
        
        <Border Grid.Row="1" BorderBrush="#444" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>

        <!-- Stations Grid -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="DUBBO RADIO (ALL)" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="150">
                <ItemsControl x:Name="ExplorerStationsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}" Tag="{Binding Station}" Click="Station_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Now Playing -->
        <StackPanel Grid.Row="3" Margin="0,15,0,15">
            <TextBlock Text="Playing:" Foreground="Gray"/>
            <TextBlock x:Name="TxtPlayingName" Text="Stopped" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtPlayingFreq" Text="" Foreground="#AAA"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Signal: " Foreground="Gray"/>
                <ProgressBar x:Name="ProgSignal" Width="150" Height="10" Minimum="0" Maximum="100" Value="0" Margin="5,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- DEBUG PANEL -->
        <Border Grid.Row="4" Background="#222" BorderBrush="#555" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="DEBUG DIAGNOSTICS" FontWeight="Bold" Foreground="Orange" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtDbgStatus" Text="NESDR: Connected" FontFamily="Consolas" Foreground="#CCC"/>
                <TextBlock x:Name="TxtDbgFreq" Text="Frequency: N/A" FontFamily="Consolas" Foreground="#CCC"/>
                <TextBlock x:Name="TxtDbgRates" Text="Hardware SR: 960 kS/s | Audio SR: 48000 Hz" FontFamily="Consolas" Foreground="#CCC"/>
            </StackPanel>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="BtnPlayPause" Content="■ Stop" Grid.Column="0" Click="BtnPlayPause_Click" Background="#500"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Volume " Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Slider x:Name="SldVolume" Width="100" Minimum="0" Maximum="1" Value="0.75" VerticalAlignment="Center" ValueChanged="SldVolume_ValueChanged"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
