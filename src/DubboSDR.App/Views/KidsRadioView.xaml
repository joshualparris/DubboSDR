<UserControl x:Class="DubboSDR.App.Views.KidsRadioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DubboSDR.App.Views"
             Background="#FFFEF0" Foreground="#333333">
    <!-- Warm playful background -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Now Playing -->
            <RowDefinition Height="*"/>    <!-- Stations Grid -->
            <RowDefinition Height="Auto"/> <!-- Controls -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnBack" Content="← Back" HorizontalAlignment="Left" FontSize="24" Padding="20,10" 
                    Background="#E0E0E0" BorderThickness="0" Click="BtnBack_Click"/>
            <TextBlock Text="🎵 KIDS RADIO" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Now Playing -->
        <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="NOW PLAYING" FontSize="18" FontWeight="Bold" Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtNowIcon" Text="📻" FontSize="72" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="TxtNowName" Text="Select a station..." FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtNowFreq" Text="" FontSize="24" Foreground="#666" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusMsg" Text="" FontSize="20" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Stations Scroll/Wrap -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StationsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" Margin="0,10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="10" Width="200" Height="200" BorderThickness="0"
                                Background="{Binding BackgroundColor}" Tag="{Binding Station}"
                                Click="StationBtn_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="10">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Gray" BlurRadius="5" Opacity="0.3" ShadowDepth="2"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Station.KidsIcon, TargetNullValue='🎵'}" FontSize="64" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="Bold" Foreground="#333333"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="Gray"
                                           HorizontalAlignment="Center" Margin="0,5,0,0" Visibility="{Binding SubtitleVisibility}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Controls -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPlayPause" Grid.Column="0" Content="⏸ PAUSE" FontSize="28" FontWeight="Bold" Background="#FF9800" Foreground="White" 
                    Padding="30,20" BorderThickness="0" Click="BtnPlayPause_Click"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="🔈" FontSize="36" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <!-- Large Custom Slider -->
                <Slider x:Name="SldVolume" Width="300" Minimum="0" Maximum="1" Value="0.75" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True" ValueChanged="SldVolume_ValueChanged">
                    <Slider.LayoutTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2"/>
                    </Slider.LayoutTransform>
                </Slider>
                <TextBlock Text="🔊" FontSize="36" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
